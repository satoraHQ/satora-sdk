{
  "name": "@satora/swap",
  "version": "1.9.0",
  "description": "Satora swap client",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./delegate": {
      "import": {
        "types": "./dist/delegate.d.ts",
        "default": "./dist/delegate.js"
      },
      "require": {
        "types": "./dist/delegate.d.cts",
        "default": "./dist/delegate.cjs"
      }
    },
    "./cctp-bridge": {
      "import": {
        "types": "./dist/cctp-bridge.d.ts",
        "default": "./dist/cctp-bridge.js"
      },
      "require": {
        "types": "./dist/cctp-bridge.d.cts",
        "default": "./dist/cctp-bridge.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/package-types.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.5.5",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "@zerodev/sdk": "^5.5.0",
    "dexie": "4.4.4",
    "openapi-fetch": "^0.17.0",
    "viem": "2.52.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@lendasat/lendaswap-sdk-pure": "workspace:*",
    "@types/better-sqlite3": "^7.6.13"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satoraHQ/swap.git",
    "directory": "client-sdk/ts-sdk/packages/swap"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@circle-fin/adapter-viem-v2": "^1.8.0",
    "@circle-fin/bridge-kit": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@circle-fin/adapter-viem-v2": {
      "optional": true
    },
    "@circle-fin/bridge-kit": {
      "optional": true
    }
  }
}
